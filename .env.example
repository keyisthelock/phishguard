# Copy to .env. Never commit .env or send keys in chat.
SECRET_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# Leave blank for SQLite. Requires Microsoft ODBC Driver 18 for SQL Server.
AZURE_SQL_CONNECTION_STRING=
# Example: Driver={ODBC Driver 18 for SQL Server};Server=tcp:YOUR.database.windows.net,1433;Database=phishguard;Uid=YOURUSER;Pwd=YOURPASSWORD;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;
COOKIE_SECURE=false
